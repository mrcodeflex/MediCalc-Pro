{
  "name": "medicalc-pro-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "MediCalc Pro: laboratory calculators as a mobile app (PWA + Android via Capacitor).",
  "scripts": {
    "test": "node tests/calc.test.js && node tests/registry.test.js",
    "android:add": "cap add android && node scripts/apply-android-assets.js",
    "sync": "cap sync android",
    "open": "cap open android",
    "apk": "cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/share": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
